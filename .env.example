# BANXE Infrastructure — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git

# ── GMKtec NucBox (production server) ─────────────────────────────────
GMKTEC_IP=192.168.0.72
GMKTEC_USER=banxe
GMKTEC_SSH_KEY=~/.ssh/gmktec_key

# ── Local paths (Legion WSL2) ──────────────────────────────────────────
LEGION_OPENCLAW_DIR=~/.openclaw
BACKUP_DIR=~/banxe_backups

# ── ClickHouse (on GMKtec) ─────────────────────────────────────────────
CLICKHOUSE_HOST=192.168.0.72
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=banxe_audit
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Encryption (GDPR Art. 32) ──────────────────────────────────────────
BANXE_KEY_PATH=~/.banxe_key
